//=============================================================================
//
// inc_wthr_fs.shd: NWN-Weathered, the fragment shader shared by
// fs_weather (with an environment map) and fs_wthr_plain (without).
// Define SHADER_TYPE, LIGHTING and the *_MAP switches before including.
//
//=============================================================================

#include "inc_standard"
#include "inc_scriptable"

uniform float DustAmount;
uniform float DustSpread;
uniform float SnowAmount;
uniform float BloodWounds;
uniform float BloodDry;
uniform float BloodOwn;
uniform float SpatterRed;
uniform float SpatterGreen;
uniform float SpatterYellow;
uniform float SpatterWhite;
uniform float WoundWeight;
uniform float SpatterWeight;
uniform float SpatterFront;
uniform float PartLow;
uniform float PartHigh;
uniform float MeshBase;
uniform float MeshHeight;
uniform float PatternSeed;  // 0..1, one per creature: shifts all its patterns

// The noise texture. HEIGHT_MAP is off, so the slot is ours.
uniform lowp int texture4Bound;
uniform sampler2D texUnit4;

varying float vWeatherHeight;
varying vec3 vWeatherNormal;
varying vec3 vWeatherPos;

// Colours in gamma space, like a texture.
#define WEATHER_DUST_DARK   vec3(0.55, 0.46, 0.34)
#define WEATHER_DUST_LIGHT  vec3(0.78, 0.68, 0.52)
#define WEATHER_SNOW_SHADE  vec3(0.80, 0.86, 0.95)
#define WEATHER_SNOW_WHITE  vec3(0.96, 0.98, 1.00)

// Noise repeats per texture width. Creature textures are small on screen,
// so anything finer turns into pixel grit.
#define WEATHER_TILE_COARSE 1.5
#define WEATHER_TILE_FINE   3.0
#define WEATHER_DUST_EDGE   0.12   // how ragged the top edge of the dust is
#define WEATHER_DUST_MAX    0.8    // most of the surface dust covers, at full dust near the ground
#define WEATHER_NOISE_LOW   0.2    // coarse noise values: about 3% of wthr_noise is below this,
#define WEATHER_NOISE_HIGH  0.88   // and 3% above this

// ---- Noise ------------------------------------------------------------------

// Two shifts 0..1 from the creature's PatternSeed, so creatures with the
// same models don't get their dust, blood and snow in the same spots.
vec2 WeatherSeed()
{
    return vec2(PatternSeed, fract(PatternSeed * 7.31 + 0.17));
}

float WeatherHash(vec2 p)
{
    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

float WeatherValueNoise(vec2 p)
{
    vec2 i = floor(p);
    vec2 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    float a = WeatherHash(i);
    float b = WeatherHash(i + vec2(1.0, 0.0));
    float c = WeatherHash(i + vec2(0.0, 1.0));
    float d = WeatherHash(i + vec2(1.0, 1.0));
    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

// R coarse, G fine, B streaks at uv.
vec3 WeatherNoise(vec2 uv)
{
    if (texture4Bound != 0)
    {
        return vec3(texture2D(texUnit4, uv * WEATHER_TILE_COARSE).r,
                    texture2D(texUnit4, uv * WEATHER_TILE_FINE).g,
                    texture2D(texUnit4, uv * WEATHER_TILE_COARSE).b);
    }
    vec2 p = uv * 6.0;
    return vec3(WeatherValueNoise(p) * 0.65 + WeatherValueNoise(p * 2.3 + 17.0) * 0.35,
                WeatherValueNoise(p * 2.5 + 5.0),
                WeatherValueNoise(vec2(p.x * 0.25, p.y * 2.0) + 31.0));
}

#define WEATHER_DUST_PER_METRE 1.5   // the dust pattern repeats about every 65 cm

// The dust pattern: R coarse blotches, B wind streaks. Placed on the model
// in 3D like blood, since textures laid out mirrored made the patches
// symmetrical: projected along each axis and blended by which way the
// surface faces, so there are no seams where it turns.
vec2 WeatherDustPattern(vec3 vNoise)
{
    vec3 vWeight = abs(vWeatherNormal);
    vWeight = vWeight * vWeight * vWeight * vWeight;
    float fSum = vWeight.x + vWeight.y + vWeight.z;
    if (texture4Bound == 0 || fSum < 0.0001) return vNoise.rb;
    vWeight /= fSum;
    vec2 vSeed = WeatherSeed();
    vec3 p = vWeatherPos * WEATHER_DUST_PER_METRE + vec3(vSeed, fract(vSeed.x * 3.7));
    return texture2D(texUnit4, p.yz).rb * vWeight.x
         + texture2D(texUnit4, p.xz).rb * vWeight.y
         + texture2D(texUnit4, p.xy).rb * vWeight.z;
}

// ---- Where on the body ------------------------------------------------------

// 0 at the feet, 1 at the top of the head.
float WeatherBodyHeight()
{
    // Cloaks are skin meshes, which get no bounding box: the material says
    // where the mesh hangs on the figure instead (see tools/build.py).
    if (MeshHeight > 0.0) return clamp((MeshBase + vWeatherPos.z) / MeshHeight, 0.0, 1.0);
    float fLocal = vWeatherHeight < 0.0 ? 0.5 : vWeatherHeight;
    return mix(PartLow, PartHigh, fLocal);
}

// How much a surface faces up, -1..1 (z is up in NWN), in the creature's
// standing pose: snow that settled on a shoulder stays on it when the arm
// swings or the creature falls over.
float WeatherUpness()
{
    return gl_FrontFacing ? vWeatherNormal.z : -vWeatherNormal.z;
}

// ---- Dust -------------------------------------------------------------------

void ApplyDust(vec3 vNoise)
{
    float fDust = clamp(DustAmount, 0.0, 1.0);
    float fSpread = clamp(DustSpread, 0.0, 1.0);
    float fHeight = WeatherBodyHeight();
    vec2 vPattern = WeatherDustPattern(vNoise);

    // How high the dust reaches: the boots at first, past the waist when
    // heavy; a storm lifts it over everything.
    float fTop = mix(0.1 + 0.75 * fDust, 1.3, fSpread);
    float fEdge = fTop - fHeight + (vPattern.x - 0.5) * WEATHER_DUST_EDGE * 2.0;
    float fReach = smoothstep(0.0, 0.12, fEdge);

    // Thickest near the ground; in a storm, wind streaks add to it.
    float fDepth = clamp((fTop - fHeight) / max(fTop, 0.05), 0.0, 1.0);
    float fPattern = mix(vPattern.x, vPattern.y, 0.35 * fSpread);
    // Patches cover a share of the surface in step with the amount, never
    // all of it: the noise value turned into roughly its rank (the share of
    // the noise below it, measured on wthr_noise), and the patches are
    // where the rank is high enough.
    float fRank = clamp((fPattern - WEATHER_NOISE_LOW) / (WEATHER_NOISE_HIGH - WEATHER_NOISE_LOW), 0.0, 1.0);
    float fStrength = fDust * (0.75 + 0.25 * fDepth);
    float fCover = fReach * smoothstep(0.0, 0.12, fRank - (1.0 - WEATHER_DUST_MAX * fStrength));

    vec3 vDust = ApplyColorSpace(mix(WEATHER_DUST_DARK, WEATHER_DUST_LIGHT, vNoise.g));
    // Where dust makes the surface matte (below): under the patches only,
    // as snow does. A film between them made the metal there matte too,
    // and matte, the armour's light silver metal colour looked like white
    // paint.
    float fMatte = fCover;

    // The stock shader swaps a shiny texture's real (dark) colour for a
    // light grey and lets the shine cover it; once dust takes the shine
    // away that grey shows, lit blue by the sky, as if painted white. Put
    // the real colour back where the dust dulls it.
    #if SPECULAR_LIGHT == 1 && ENVIRONMENT_MAP == 1 && NO_TEXTURE != 1
        if (texture0Bound != 0 && fEnvMapLevel > 0.0)
        {
            vec3 vTexture = ApplyColorSpace(texture2D(texUnit0, vTexCoords.xy).rgb);
            FragmentColor.rgb = mix(FragmentColor.rgb, vTexture, fMatte * fEnvMapLevel);
        }
    #endif

    float fGrey = dot(FragmentColor.rgb, vec3(0.299, 0.587, 0.114));
    // A light film dulls the colours between the patches too; light, so
    // the gaps still look clean next to them.
    vec3 vDull = mix(FragmentColor.rgb, vec3(fGrey), 0.15 * fDust * fReach);

    // How strongly the dust colour is laid on: 75% on cloth, with soft
    // edges. On shiny parts it has to cover faster than the shine fades
    // (below): halfway into a patch's edge the shine is half gone, and the
    // light grey the stock shader keeps under a shine showed through as a
    // white ring around every patch. There it is full strength by then.
    float fShiny = 0.0;
    #if ENVIRONMENT_MAP == 1
        fShiny = fEnvMapLevel;
    #endif
    float fColour = mix(fCover * 0.75, min(fCover * 2.0, 1.0), fShiny);
    FragmentColor.rgb = mix(vDull, vDust, fColour);

    // Dust is matte, the same way as snow: less shine and a rougher
    // surface. The material's own metal look and highlight colour stay
    // (replacing those turned dusty armour bronze or made it mirror the
    // sky).
    #if SPECULAR_LIGHT == 1
        #ifdef MATERIAL_SPECULARITY_GENERATE_VALUE
            // The shine drops slowly at first, so the dust colour covers
            // the light grey under it before it shows: a twelfth of the way
            // by a quarter into a patch's edge (armour: 98% -> 90%), then on
            // to 2% inside.
            float fDrop = fMatte < 0.25 ? fMatte / 3.0 : 1.0 / 12.0 + (fMatte - 0.25) * 11.0 / 9.0;
            MATERIAL_SPECULARITY_VALUE = mix(MATERIAL_SPECULARITY_VALUE, 0.02, fDrop);
        #endif
        #ifdef MATERIAL_ROUGHNESS_GENERATE_VALUE
            MATERIAL_ROUGHNESS_VALUE = mix(MATERIAL_ROUGHNESS_VALUE, 0.9, fMatte);
        #endif
    #endif
}

// ---- Snow -------------------------------------------------------------------

void ApplySnow(vec3 vNoise)
{
    float fSnow = clamp(SnowAmount, 0.0, 1.0);

    // Only surfaces that face up hold snow; steeper ones lose it fast.
    float fUp = WeatherUpness();
    float fSettle = smoothstep(0.3, 0.8, fUp);

    // Clumps from the coarse noise, with soft edges.
    float fCover = smoothstep(0.0, 0.35, fSnow * 1.4 * fSettle - (1.0 - vNoise.r) * 0.7);

    // A soft shadow on the cloth just around the snow makes it sit on top.
    float fRim = fCover * (1.0 - fCover) * 4.0;
    vec3 vCloth = FragmentColor.rgb * (1.0 - 0.2 * fRim);
    vec3 vSnow = ApplyColorSpace(mix(WEATHER_SNOW_SHADE, WEATHER_SNOW_WHITE, vNoise.g));
    FragmentColor.rgb = mix(vCloth, vSnow, fCover);

    // Snow is matte: no shine, so the sky doesn't reflect in it.
    #if SPECULAR_LIGHT == 1
        #ifdef MATERIAL_SPECULARITY_GENERATE_VALUE
            MATERIAL_SPECULARITY_VALUE = mix(MATERIAL_SPECULARITY_VALUE, 0.02, fCover);
        #endif
        #ifdef MATERIAL_ROUGHNESS_GENERATE_VALUE
            MATERIAL_ROUGHNESS_VALUE = mix(MATERIAL_ROUGHNESS_VALUE, 0.9, fCover);
        #endif
    #endif
}

// ---- Blood ------------------------------------------------------------------

#define WEATHER_DROPS_PER_METRE 4.0   // the droplet texture spans 25 cm (see WeatherBloodSample)

// Blood is placed on the model in 3D, not by its texture layout: creature
// textures are mostly mirrored (one texture half serves both sides of a
// chest, one texture both shins), which made every stain symmetrical. The
// droplet texture is projected onto the model in its standing pose from
// the side the surface faces most: front/back, left/right or top.
// Returns (drops, blotch, cluster): drops 0 (none) or the drop's order
// 0.25..1 (a drop shows once the amount is high enough for its order, so
// more blood brings more drops); blotch 0..1 for the stains of heavy
// amounts; cluster 0..1, where blood gathers (see WeatherBloodCover).
vec3 WeatherBloodSample(vec2 vOffset)
{
    vec3 vAxis = abs(vWeatherNormal);
    vec2 uv;
    if (vAxis.x >= vAxis.y && vAxis.x >= vAxis.z) uv = vWeatherPos.yz;
    else if (vAxis.y >= vAxis.z)                uv = vWeatherPos.xz;
    else                                         uv = vWeatherPos.xy;
    // The seed shifts by several tiles, so the slow cluster and pick
    // patterns below move too, not only the drops.
    uv = uv * WEATHER_DROPS_PER_METRE + vOffset + WeatherSeed() * 7.7;
    if (texture4Bound != 0)
    {
        // The pattern repeats every 25 cm, which showed on big surfaces: a
        // cloak's back is two repeats wide, so its halves matched. Two more
        // copies, turned and scaled by odd amounts (one with smaller drops,
        // one with bigger), take over in irregular patches some 30 cm
        // across, picked by the coarse noise, so no two stretches match.
        // All three are sampled before choosing: choosing the coordinates
        // first left a blurred seam where the copies meet (the jump
        // confuses the texture's filtering).
        vec2 uvSmall = mat2(0.8, 0.6, -0.6, 0.8) * uv * 1.37 + vec2(0.29, 0.71);
        vec2 uvLarge = mat2(0.28, -0.96, 0.96, 0.28) * uv * 0.62 + vec2(0.83, 0.41);
        float fPick = texture2D(texUnit4, uv * 0.2 + vec2(0.53, 0.17)).r;
        vec4 vStraight = texture2D(texUnit4, uv);
        vec4 vSmall = texture2D(texUnit4, uvSmall);
        vec4 vLarge = texture2D(texUnit4, uvLarge);
        vec4 vTexel = fPick < 0.5 ? vStraight : (fPick < 0.65 ? vLarge : vSmall);
        // Where blood gathers: a slower pattern, about 50 cm across.
        float fCluster = smoothstep(0.3, 0.75, texture2D(texUnit4, uv * 0.13 + vec2(0.11, 0.47)).r);
        return vec3(vTexel.a, vTexel.r, fCluster);
    }
    float f = WeatherValueNoise(uv * 25.0);
    return vec3(f > 0.72 ? 0.25 + 0.75 * (f - 0.72) / 0.28 : 0.0, WeatherValueNoise(uv * 3.0),
                WeatherValueNoise(uv * 0.5));
}

// Gamma-space colour of blood kind 1..4 (red, green, yellow, white).
vec3 WeatherBloodColor(float fKind)
{
    if (fKind < 1.5) return vec3(0.42, 0.02, 0.02);
    if (fKind < 2.5) return vec3(0.18, 0.40, 0.06);
    if (fKind < 3.5) return vec3(0.65, 0.55, 0.08);
    return vec3(0.82, 0.82, 0.76);
}

// Dried blood is darker and browner.
vec3 WeatherDried(vec3 vColor, float fDry)
{
    return mix(vColor, vColor * 0.45 + vec3(0.07, 0.035, 0.01), clamp(fDry, 0.0, 1.0));
}

// How much of a layer shows here, for an amount 0..1 (vSample from
// WeatherBloodSample): drops appear in step with the amount, so blood that
// builds up over an adventure looks like it. The same amount everywhere
// looked like wallpaper, so blood gathers: up to 1.6 times as much where
// the cluster pattern is high, a few drops where it is low, the same
// overall (measured on wthr_noise).
float WeatherBloodCover(float fAmount, vec3 vSample)
{
    float fHere = clamp(fAmount, 0.0, 1.0) * mix(0.15, 1.6, vSample.z);
    float fDrop = vSample.x > 0.0 ? smoothstep(0.0, 0.05, vSample.x - (1.0 - fHere * 1.15)) : 0.0;
    // Heavy amounts soak in as stains between the drops.
    float fStain = smoothstep(0.55, 0.85, vSample.y) * min(fHere, 1.0) * 0.7;
    return max(fDrop, fStain);
}

// Blood over metal armour: with per-pixel lighting a texture's shiny parts
// show mostly reflection and hardly any colour, so blood painted into the
// colour alone vanished on metal. Where blood covers, the surface stops
// being metal: a soft wet sheen in the blood's own colour while fresh,
// matte once dried.
void WeatherBloodSurface(float fCover, vec3 vBlood)
{
    #if SPECULAR_LIGHT == 1
        if (fCover <= 0.0) return;
        #ifdef MATERIAL_METALLICNESS_GENERATE_VALUE
            MATERIAL_METALLICNESS_VALUE = mix(MATERIAL_METALLICNESS_VALUE, 0.0, fCover);
        #endif
        #ifdef MATERIAL_SPECULARITY_GENERATE_VALUE
            MATERIAL_SPECULARITY_VALUE = mix(MATERIAL_SPECULARITY_VALUE, mix(0.04, 0.02, BloodDry), fCover);
        #endif
        #ifdef MATERIAL_ROUGHNESS_GENERATE_VALUE
            MATERIAL_ROUGHNESS_VALUE = mix(MATERIAL_ROUGHNESS_VALUE, mix(0.55, 0.9, BloodDry), fCover);
        #endif
        #ifdef MATERIAL_SPECULAR_COLOR_GENERATE_VALUE
            MATERIAL_SPECULAR_COLOR_VALUE = mix(MATERIAL_SPECULAR_COLOR_VALUE, vBlood, fCover);
        #endif
    #endif
}

// One colour of others' blood: fAmount 0..1 of blood kind fKind, drawn
// from the droplets at vOffset.
void ApplySpatter(float fAmount, float fKind, vec2 vOffset, float fWeight)
{
    if (fAmount <= 0.0) return;
    float fCover = WeatherBloodCover(clamp(fAmount, 0.0, 1.0) * fWeight, WeatherBloodSample(vOffset));
    vec3 vBlood = ApplyColorSpace(WeatherDried(WeatherBloodColor(fKind), BloodDry));
    FragmentColor.rgb = mix(FragmentColor.rgb, vBlood, fCover * 0.9);
    WeatherBloodSurface(fCover * 0.9, vBlood);
}

void ApplyBlood(vec3 vNoise)
{
    if (scriptableInt16 == 1) return;  // gore off for this player
    float fFront = gl_FrontFacing ? vWeatherNormal.y : -vWeatherNormal.y;

    if (BloodWounds > 0.0 && BloodOwn > 0.5)
    {
        float fAmount = clamp(BloodWounds, 0.0, 1.0) * WoundWeight;
        float fCover = WeatherBloodCover(fAmount, WeatherBloodSample(vec2(0.0)));
        vec3 vBlood = ApplyColorSpace(WeatherDried(WeatherBloodColor(BloodOwn), BloodDry));
        FragmentColor.rgb = mix(FragmentColor.rgb, vBlood, fCover * 0.9);
        WeatherBloodSurface(fCover * 0.9, vBlood);
    }
    // Others' blood, one layer per colour: each uses its own part of the
    // droplet pattern (and its own stain blotches), so red and green drops
    // sit side by side instead of mixing into one colour.
    // Mostly on the front, where the blows land.
    float fFacing = mix(1.0, smoothstep(-0.4, 0.5, fFront), SpatterFront) * SpatterWeight;
    ApplySpatter(SpatterRed, 1.0, vec2(0.37, 0.61), fFacing);
    ApplySpatter(SpatterGreen, 2.0, vec2(0.13, 0.82), fFacing);
    ApplySpatter(SpatterYellow, 3.0, vec2(0.71, 0.29), fFacing);
    ApplySpatter(SpatterWhite, 4.0, vec2(0.55, 0.07), fFacing);
}

float WeatherSpatterTotal()
{
    return SpatterRed + SpatterGreen + SpatterYellow + SpatterWhite;
}

void main ()
{
    FragmentColor = vec4(1.0);
    SetupStandardShaderInputs();
    float fSpatter = WeatherSpatterTotal();
    if (DustAmount > 0.0 || SnowAmount > 0.0 || BloodWounds > 0.0 || fSpatter > 0.0)
    {
        vec3 vNoise = WeatherNoise(vTexCoords.xy + WeatherSeed());
        if (DustAmount > 0.0) ApplyDust(vNoise);
        if (BloodWounds > 0.0 || fSpatter > 0.0) ApplyBlood(vNoise);
        if (SnowAmount > 0.0) ApplySnow(vNoise);
    }
    ApplyStandardShader();
    gl_FragColor = FragmentColor;
}
