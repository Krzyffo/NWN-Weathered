//=============================================================================
//
// inc_wthr_vs.shd: NWN-Weathered, the vertex shader shared by vs_weather
// (with an environment map) and vs_wthr_plain (without).
//
//=============================================================================

#include "inc_standard"
#include "inc_uniforms"

varying float vWeatherHeight;
varying vec3 vWeatherNormal;  // standing pose, model space: z up, y forward
varying vec3 vWeatherPos;     // standing pose, model space, in metres

void main ()
{
    ApplyStandardShader();

    float fSpan = bboxMax.z - bboxMin.z;
    vWeatherHeight = fSpan > 0.01 ? clamp((vPos.z - bboxMin.z) / fSpan, 0.0, 1.0) : -1.0;
    vWeatherNormal = dot(vNormal, vNormal) > 0.0 ? normalize(vNormal) : vec3(0.0);
    vWeatherPos = vPos.xyz;
    // Left and right body parts are mirror copies (the box leans the other
    // way along x), so patterns placed by position came out mirrored too.
    // Shift each side's pattern by a different amount; not along z, which
    // a cloak's height is read from.
    float fCentre = bboxMin.x + bboxMax.x;
    if (fSpan > 0.01 && abs(fCentre) > 0.001)
        vWeatherPos.xy += sign(fCentre) * vec2(0.37, 0.53);
}
