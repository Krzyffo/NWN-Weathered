//=============================================================================
//
// fs_weather.shd: NWN-Weathered
//
// The stock lit fragment shader (fslit_sm) with dust and snow added to the
// surface before lighting, so they are lit and shaded like the cloth under
// them. Used through the generated .mtr materials, one per creature
// texture; each creature sets its own values with
// SetMaterialShaderUniformVec4(oCreature, sMaterial, "DustAmount", x).
//
//   DustAmount  0..1  dust; climbs from the feet up as it grows
//   DustSpread  0..1  0 = from the ground up, 1 = all over (dust storm)
//   SnowAmount  0..1  snow settling on upward-facing surfaces, in clumps
//   BloodWounds 0..1  the creature's own blood, from taking blows
//   SpatterRed, SpatterGreen, SpatterYellow, SpatterWhite  0..1 each:
//                     others' blood, from hitting them in melee: hands,
//                     arms and the front of the body
//   BloodDry    0..1  fresh to dried (darker, browner)
//   BloodOwn          own blood colour: 0 none, 1 red, 2 green, 3 yellow,
//                     4 white
//   PartLow, PartHigh (fixed per texture) where this body part sits on the
//                     figure, 0 = feet, 1 = top of the head
//   WoundWeight, SpatterWeight (fixed per texture) how much blood this
//                     body part catches
//   SpatterFront      (fixed per texture) how much spatter favours the
//                     front: 0.75 on creatures, 0 on placeables and doors
//
// Blood is hidden for a player whose game has gore turned off: the scripts
// set scriptableInt16 to 1 for them.
//
// Noise comes from the wthr_noise texture in the height-map slot (R coarse
// blotches, G fine grain, B streaks, A blood droplets), or is computed if
// that isn't bound.
//
//=============================================================================

#define SHADER_TYPE 2

#define LIGHTING 1
#define FOG 1
#define KEYHOLING 1

#define NORMAL_MAP 0
#define SPECULAR_MAP 0
#define ROUGHNESS_MAP 0
#define HEIGHT_MAP 0
#define SELF_ILLUMINATION_MAP 0
#define ENVIRONMENT_MAP 1

#include "inc_wthr_fs"
